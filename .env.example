# Скопируйте этот файл в .env и заполните значения
# НИКОГДА не коммитьте настоящий .env в git

# Порт, на котором будет работать сервер
PORT=3000

# Логин администратора
ADMIN_USERNAME=admin

# Хэш пароля администратора (bcrypt). Сгенерировать: npm run create-user
ADMIN_PASSWORD_HASH=

# Случайная длинная строка для подписи JWT-токенов. Сгенерировать, например:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Время жизни сессии (JWT), например: 12h, 7d
JWT_EXPIRES_IN=12h

# ОПАСНО: true полностью отключает вход по паролю — сайт открыт всем, у кого
# есть ссылка (никакого экрана логина, любой запрос выполняется без токена).
# Используйте только временно, для локальной отладки, и верните в false,
# как только закончите. Держите false, если доступ идёт через интернет/Tailscale.
DISABLE_AUTH=false

# Необязательно: список IP/адресов, которым разрешён доступ, через запятую.
# Полезно, если ПК доступен через Tailscale (адреса вида 100.x.x.x).
# Оставьте пустым, чтобы не ограничивать по IP.
ALLOWED_IPS=

# Необязательно: пути к TLS-сертификату для запуска по HTTPS напрямую
# (обычно не нужно, если используете Tailscale Funnel / Cloudflare Tunnel / Caddy — они сами дают HTTPS)
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=
